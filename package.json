{
  "name": "qrcode",
  "description": "QR Code generator \u2014 web application",
  "keywords": [
    "qrcode",
    "react",
    "typescript",
    "vite"
  ],
  "homepage": "https://github.com/alex-pimentel/qrcode#readme",
  "bugs": {
    "url": "https://github.com/alex-pimentel/qrcode/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alex-pimentel/qrcode.git"
  },
  "license": "MIT",
  "author": {
    "name": "Alex Pimentel",
    "url": "https://github.com/alex-pimentel"
  },
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/ui",
    "packages/web"
  ],
  "scripts": {
    "lint": "eslint packages/",
    "types": "tsc -p packages/web/tsconfig.json --noEmit",
    "build": "npm run build -w packages/web",
    "format": "prettier --check .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "5.0.3",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18.x"
  },
  "overrides": {
    "undici": "^7.30.0",
    "nanoid": "^3.3.19",
    "browserslist": "^4.29.3",
    "brace-expansion": "^5.0.12",
    "@clerk/clerk-react": "^5.61.10"
  }
}
